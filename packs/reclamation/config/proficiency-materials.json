  "_why": {
    "maces/2": "wind_charge and breeze_rod do not exist in 1.20.1; the port's mace is an iron block on a blaze rod",
    "maces/3": "minecraft:mace does not exist in 1.20.1; the port adds proficiency:mace",
    "maces/4": "heavy_core does not exist in 1.20.1",
    "tridents/1": "no ocean monuments, prismarine only from the Natural Altar (quartz, mid game); drowned in dead oceans drop flesh",
    "tridents/3": "sponge has no source (no elder guardians; the bee hydroregulator only dries/wets one)",
    "unarmed/1": "leather and feathers need animals (Nature's Aura birthing altar / Sentient Life, quest depth 33-35)",
    "unarmed/2": "rabbits only come back with the arid/icy biome bottles (end of the quest book)",
    "endurance/1": "no cows or leather early; fishing works from day one",
    "endurance/3": "1.20.1 calls it minecraft:scute (turtle_scute is 1.20.5+); turtles from the birthing altar",
    "endurance/4": "no evokers (no mansions, no raids), so no totem; Gaia Guardian's life essence instead",
    "archery/1": "no chickens until Sentient Life (quest depth 33); skeletons drop both arrows and bones",
    "mining/1": "no coal anywhere (no ore; first coal is Botania Orechid, late); dead logs smelt into charcoal",
    "woodcutting/1": "oak and birch only after saplings (mutandis) grown on scarce dirt; dead trees are the wood of the early game",
    "woodcutting/2": "Biomes We've Gone is not in the pack; rowan is the pack's own witch tree",
    "woodcutting/3": "BWG and the Aether are not in the pack; livingwood and ancient logs are the pack's magic woods",
    "woodcutting/4": "Twilight Forest and Gardens of the Dead are not in the pack; archwood and Alfheim's dreamwood instead",
    "excavation/1": "the ground is dried earth; real dirt is the first thing the pack makes you craft",
    "running/1": "no leather early",
    "running/2": "no rabbits until the arid/icy biome bottles",
    "sneaking/1": "black dye needs ink sacs or Botania petals, neither early",
    "sneaking/3": "no deep dark, so no sculk",
    "sneaking/4": "no deep dark, so no warden and no echo shards",
    "jumping/1": "no slimes spawn and no chickens early; bees are an early quest",
    "jumping/2": "no rabbits; slime from Botania (cactus) or Create, mid game",
    "jumping/3": "chorus only grows in the End, the last chapter",
    "swimming/1": "no kelp in the dead oceans; underwater clay deposits are the sea's early find",
    "swimming/2": "sponge has no source",
    "swimming/3": "1.20.1 calls it minecraft:scute",
    "smithing/1": "no coal; charcoal from dead logs",
    "cooking/1": "no cows until the birthing altar (quest depth 35)",
    "cooking/3": "Farmer's Delight rice is filtered out of AgriCraft and has no wild rice; Croptopia rice grows",
    "spellcasting/3": "no echo shards",
    "beastslaying/3": "Twilight Forest is not in the pack; Wilden hunters come from the Ars summoning ritual",
    "wayfaring/1": "a compass needs redstone (mid game); the pack's camera is a copper early quest",
    "wayfaring/2": "Waystones is not in the pack",
    "wayfaring/3": "no echo shards",
    "spelunking/3": "no deep dark: no sculk, no echo shards",
    "masonry/1": "no oak early; a flimsy plank is a whole dead log, so 32 is the 128 oak planks' 32 logs",
    "decorating/2": "Handcrafted is not in the pack; Macaw's Furniture is",
    "decorating/4": "Handcrafted is not in the pack",
    "social/1": "cake needs milk and eggs (animals, quest depth 33-35)",
    "social/2": "a bell cannot be crafted and there are no villages; no villagers to earn emeralds from",
    "courage/1": "goats only from the birthing altar (quest depth 35)",
    "courage/2": "ominous_bottle does not exist in 1.20.1; no villagers for emeralds",
    "courage/3": "no evokers, so no totem; the Wilden Chimera's tribute is the pack's mid-game boss trophy",
    "nightwalker/1": "a clock needs gold and redstone, glow berries need Create haunting; endermen and cave spiders are the night's early drops",
    "nightwalker/3": "no deep dark: no echo shards or sculk",
    "nightwalker/4": "a recovery compass needs echo shards",
    "charger/1": "no leather early",
    "tactician/1": "a spyglass needs amethyst (quest depth 41)"
  }
}
